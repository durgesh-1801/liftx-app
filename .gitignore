# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# ─── Environment variables (NEVER commit these) ───────────────────────────────
.env
.env.*
!.env.example
*.local

# ─── Compiled output ──────────────────────────────────────────────────────────
dist
tmp
out-tsc
*.tsbuildinfo

# ─── Expo / React Native ──────────────────────────────────────────────────────
.expo
.expo-shared
expo-env.d.ts
android/
ios/

# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules

# ─── IDEs and editors ─────────────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ─── Logs ─────────────────────────────────────────────────────────────────────
npm-debug.log
yarn-error.log
yarn-debug.log
testem.log
*.log

# ─── Misc ─────────────────────────────────────────────────────────────────────
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
/typings

# ─── System Files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Replit internals (not needed on GitHub) ──────────────────────────────────
.cache/
.local/
.cursor/
.github/
